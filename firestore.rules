rules_version = '2';

// Duo security rules. Auth is anonymous (no sign-up); access is decided by pair membership.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Every user can only touch their own pointer to their pair.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // A code can be looked up by exact id (get), but never listed.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /pairs/{pairId} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }

      // Members can read. A pair that still has an empty seat can be read by the person joining it.
      allow get: if isMember() || (signedIn() && resource.data.members.size() < 2);
      allow list: if false;

      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];

      // Members can update; a newcomer can take the single empty seat (and nothing else).
      allow update: if isMember()
        || (signedIn()
            && resource.data.members.size() == 1
            && request.resource.data.members.size() == 2
            && request.auth.uid in request.resource.data.members);

      function memberOfParent() {
        return signedIn() && request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.members;
      }

      match /habits/{habitId} {
        allow read, create, update, delete: if memberOfParent();
      }

      match /completions/{id} {
        allow read: if memberOfParent();
        // You can only write your own completions.
        allow create, update: if memberOfParent() && request.resource.data.uid == request.auth.uid;
        allow delete: if memberOfParent() && resource.data.uid == request.auth.uid;
      }

      match /pulses/{id} {
        allow read: if memberOfParent();
        allow create: if memberOfParent() && request.resource.data.fromUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
